[Unit]
Description=Cooling Control daemon - Razer pad (curve / game mode via signals)
After=graphical-session.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/lib/cooling-ctl/coolingctld.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
