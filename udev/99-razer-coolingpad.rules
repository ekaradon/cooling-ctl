# Razer Laptop Cooling Pad (1532:0f43) — unprivileged hidraw/usb access for
# the coolingctld user daemon. Install into /etc/udev/rules.d/ then
# `udevadm control --reload && udevadm trigger` (or replug the pad).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0f43", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0f43", MODE="0666"
